configuration {
    modi:                   "combi,drun,run,window,filebrowser";
    combi-modi:             "drun,run,window,filebrowser";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    terminal:               "alacritty";
    font:                   "JetBrainsMono Nerd Font 12";
    drun-display-format:    "{icon} {name}";
    disable-history:        false;
    hide-scrollbar:         true;
    sidebar-mode:           true;
    sorting-method:         "fzf";
    matching:               "fuzzy";
    display-combi:          " search ";
    display-drun:           " apps ";
    display-run:            " run ";
    display-window:         " windows ";
    display-filebrowser:    " files ";
}

@import "catppuccin-mocha.rasi"

window {
    width:            640px;
    border:           1px;
    border-color:     @surface;
    background-color: @bg;
    padding:          12px;
}

mainbox {
    background-color: @bg;
    spacing:          10px;
    children:         [ inputbar, mode-switcher, listview ];
}

inputbar {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           0;
    padding:          10px 12px;
    spacing:          8px;
    children:         [ prompt, entry ];
}

prompt {
    background-color: @blue;
    text-color:       @bg;
    padding:          4px 10px;
}

entry {
    background-color: @transparent;
    text-color:       @fg;
    placeholder:      "search everything…";
    placeholder-color: @overlay;
    padding:          4px 0;
}

mode-switcher {
    background-color: @bg;
    spacing:          4px;
}

button {
    background-color: @bg-alt;
    text-color:       @overlay;
    padding:          6px 10px;
}

button selected {
    background-color: @bg-alt;
    text-color:       @peach;
}

listview {
    background-color: @bg;
    columns:          1;
    lines:            10;
    spacing:          2px;
    padding:          4px 0 0 0;
}

element {
    background-color: @bg;
    text-color:       @fg;
    padding:          8px 10px;
}

element-icon {
    size:             22px;
    padding:          0 8px 0 0;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element selected {
    background-color: @bg-alt;
    text-color:       @peach;
}

element selected.normal {
    background-color: @bg-alt;
    text-color:       @peach;
}

message {
    background-color: @bg-alt;
    text-color:       @teal;
    padding:          8px;
}

textbox {
    background-color: @bg-alt;
    text-color:       @teal;
}
